{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "yachiyo-desktop",
  "version": "0.1.0",
  "identifier": "com.yachiyo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "八千代桌宠",
        "width": 360,
        "height": 540,
        "minWidth": 280,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
